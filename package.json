{
  "name": "european-cv-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File ./build-bundle.ps1",
    "build:bundle": "powershell -ExecutionPolicy Bypass -File ./build-bundle.ps1 -SkipStandalone",
    "test": "playwright test",
    "test:unit": "powershell -ExecutionPolicy Bypass -File ./run_tests.ps1",
    "test:print": "powershell -ExecutionPolicy Bypass -File ./tests/print-check.ps1",
    "test:e2e": "playwright test",
    "test:all": "npm run build:bundle && npm run test:unit && npm run test:print && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1"
  }
}
